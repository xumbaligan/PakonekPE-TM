<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pakonek Performance</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="d-flex">
        <aside class="sidebar text-white p-3" style="background-color: #0a2aa8;">
            <h4 class="mb-4"><i class="bi bi-graph-up-arrow"></i> Pakonek</h4>
            <nav class="nav flex-column">
                <a class="nav-link text-white" asp-page="/Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
                <a class="nav-link text-white" asp-page="/Departments/Index"><i class="bi bi-building"></i> Departments</a>
                <a class="nav-link text-white" asp-page="/Employees/Index"><i class="bi bi-people"></i> Employees</a>
                <a class="nav-link text-white" asp-page="/Criteria/Index"><i class="bi bi-list-check"></i> Criteria</a>
                <a class="nav-link text-white" asp-page="/OfficeTask/Index"><i class="bi bi-list-check"></i> Tasks</a>
                <a class="nav-link text-white" asp-page="/OfficeStaff/Index"><i class="bi bi-person-workspace"></i> Employee Tasks</a>
                <a class="nav-link text-white" asp-page="/OfficeStaff/PerformanceRecords"><i class="bi bi-award"></i> My Performance Records</a>
            </nav>
        </aside>
        <main class="flex-grow-1 p-4 bg-light min-vh-100">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
