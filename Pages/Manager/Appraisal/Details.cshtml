@page "{id:int}"
@model TM_PE.Pages.Manager.Appraisal.DetailsModel
@{
    ViewData["Title"] = "Appraisal Details";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-award"></i> Appraisal Details</h2>
    <div>
        @if (Model.Item.AppraisalStatus == TM_PE.Model.AppraisalStatus.Draft)
        {
            <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@Model.Item.AppraisalID"><i class="bi bi-pencil"></i> Edit</a>
        }
        <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card p-4 mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Employee</div>
                    <div class="fw-semibold">@(Model.Item.Employee?.FullName ?? "—")</div>
                    <div class="text-muted small">@Model.Item.Employee?.RoleType</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Related Evaluation</div>
                    <div class="fw-semibold">@(Model.Item.Evaluation?.EvaluationPeriod ?? "—")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Appraisal Date</div>
                    <div class="fw-semibold">@Model.Item.AppraisalDate.ToString("MMMM d, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Overall Rating</div>
                    <div class="fw-semibold">@Model.Item.OverallRating</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (Model.Item.AppraisalStatus == TM_PE.Model.AppraisalStatus.Finalized)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis">Finalized</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Draft</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-4 mb-4">
            <h5 class="mb-3">Recommendation</h5>
            <div class="mb-2"><span class="badge bg-primary-subtle text-primary fs-6">@Model.Item.CombinedRecommendationLabel()</span></div>
            <ul class="list-unstyled small text-muted mb-0">
                <li>Salary Adjustment: @(Model.Item.SalaryAdjustmentRecommendation ? "Yes" : "No")</li>
                <li>Promotion: @(Model.Item.PromotionRecommendation ? "Yes" : "No")</li>
                <li>Training: @(Model.Item.TrainingRecommendation ? "Yes" : "No")</li>
            </ul>
        </div>

        <div class="card p-4 mb-4">
            <div class="text-muted small">Manager Remarks</div>
            <div>@(string.IsNullOrEmpty(Model.Item.ManagerRemarks) ? "—" : Model.Item.ManagerRemarks)</div>
        </div>

        <div class="card p-4">
            <h5 class="mb-3">Feedback on File</h5>
            @if (!Model.RelatedFeedback.Any())
            {
                <div class="text-muted">No feedback linked to this evaluation.</div>
            }
            else
            {
                @foreach (var f in Model.RelatedFeedback)
                {
                    <div class="border-bottom pb-2 mb-2">
                        <span class="badge bg-secondary-subtle text-secondary">@f.FeedbackType</span>
                        <span class="ms-1">@f.Comment</span>
                        <div class="text-muted small">@f.SubmittedBy — @f.DateCreated.ToString("MMM d, yyyy")</div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">Evaluation Overall Score</div>
            <div class="display-6 fw-bold">@(Model.Item.Evaluation?.OverallScore.ToString("0.#") ?? "—")</div>
            <div class="text-muted">out of 100</div>
        </div>
    </div>
</div>
