@page
@model TM_PE.Pages.Manager.Feedback.IndexModel
@{
    ViewData["Title"] = "Feedback";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-chat-square-text"></i> Feedback</h2>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg"></i> New Feedback</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" name="Search" value="@Model.Search"
               placeholder="Search by employee, comment, or submitter..." />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="TypeFilter" onchange="this.form.submit()">
            <option value="">All Types</option>
            @foreach (var t in Enum.GetValues<TM_PE.Model.FeedbackType>())
            {
                <option value="@t" selected="@(Model.TypeFilter == t.ToString())">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" type="submit"><i class="bi bi-search"></i> Filter</button>
    </div>
</form>

<div class="card">
    <table class="table table-hover mb-0 align-middle">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Type</th>
                <th>Comment</th>
                <th>Submitted By</th>
                <th>Related Evaluation</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.FeedbackList.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No feedback recorded yet.</td>
                </tr>
            }
            else
            {
                @foreach (var f in Model.FeedbackList)
                {
                    var badgeClass = f.FeedbackType switch
                    {
                        TM_PE.Model.FeedbackType.Positive => "bg-success-subtle text-success-emphasis",
                        TM_PE.Model.FeedbackType.Recognition => "bg-primary-subtle text-primary-emphasis",
                        TM_PE.Model.FeedbackType.Improvement => "bg-warning-subtle text-warning-emphasis",
                        TM_PE.Model.FeedbackType.Concern => "bg-danger-subtle text-danger-emphasis",
                        _ => "bg-secondary-subtle text-secondary"
                    };
                    <tr>
                        <td>
                            <strong>@(f.Employee?.FullName ?? "—")</strong>
                            <div class="text-muted small">@f.Employee?.RoleType</div>
                        </td>
                        <td><span class="badge @badgeClass">@f.FeedbackType</span></td>
                        <td class="text-truncate" style="max-width:320px">@f.Comment</td>
                        <td>@f.SubmittedBy</td>
                        <td>@(f.Evaluation != null ? f.Evaluation.EvaluationPeriod : "—")</td>
                        <td class="text-muted">@f.DateCreated.ToString("MMM d, yyyy")</td>
                        <td class="text-end">
                          @*   <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@f.FeedbackID">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@f.FeedbackID">
                                <i class="bi bi-trash"></i>
                            </a> *@
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
