@page "{id:int}"
@model TM_PE.Pages.Manager.PerformanceEvaluation.DetailsModel
@{
    ViewData["Title"] = "Evaluation Details";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard-data"></i> Performance Evaluation</h2>
    <div>
        @if (Model.Evaluation.EvaluationStatus == TM_PE.Model.EvaluationStatus.Draft)
        {
            <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@Model.Evaluation.EvaluationID">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card p-4 mb-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Employee</div>
                    <div class="fw-semibold">@(Model.Evaluation.Employee?.FullName ?? "—")</div>
                    <div class="text-muted small">@Model.Evaluation.Employee?.RoleType</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Evaluator</div>
                    <div class="fw-semibold">@Model.Evaluation.EvaluatorName</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Evaluation Period</div>
                    <div class="fw-semibold">@Model.Evaluation.EvaluationPeriod</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Evaluation Date</div>
                    <div class="fw-semibold">@Model.Evaluation.EvaluationDate.ToString("MMMM d, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Status</div>
                    <div>
                        @if (Model.Evaluation.EvaluationStatus == TM_PE.Model.EvaluationStatus.Finalized)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis">Finalized</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">Draft</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card p-4 mb-4">
            <h5 class="mb-3">Evaluation Results</h5>
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Criteria</th>
                        <th>Weight</th>
                        <th>Score</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Evaluation.Results.OrderByDescending(r => r.Criteria?.Weight))
                    {
                        <tr>
                            <td>@(r.Criteria?.CriteriaName ?? "—")</td>
                            <td>@(r.Criteria?.Weight.ToString("0.##") ?? "—")%</td>
                            <td><strong>@r.Score.ToString("0.##")</strong> / @(r.Criteria?.Weight.ToString("0.##") ?? "—")</td>
                            <td class="text-muted">@(string.IsNullOrEmpty(r.Remarks) ? "—" : r.Remarks)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="2">Overall Score</td>
                        <td colspan="2">@Model.Evaluation.OverallScore.ToString("0.##") / 100 — @Model.Evaluation.OverallRating</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="card p-4">
            <div class="text-muted small">General Remarks</div>
            <div>@(string.IsNullOrEmpty(Model.Evaluation.GeneralRemarks) ? "—" : Model.Evaluation.GeneralRemarks)</div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card p-4 text-center">
            <div class="text-muted small">Overall Score</div>
            <div class="display-4 fw-bold">@Model.Evaluation.OverallScore.ToString("0.#")</div>
            <div class="text-muted">out of 100</div>
            <span class="badge bg-primary-subtle text-primary mt-2">@Model.Evaluation.OverallRating</span>
        </div>
    </div>
</div>
