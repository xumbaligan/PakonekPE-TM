@page
@model TM_PE.Pages.Manager.PerformanceEvaluation.CreateModel
@{
    ViewData["Title"] = "New Performance Evaluation";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard-data"></i> New Performance Evaluation</h2>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@* ===================== Employee performance snapshot ===================== *@
<div class="row g-3 mb-4" id="statTiles">
    <div class="col-6 col-lg-3">
        <div class="stat-tile d-flex align-items-center gap-3">
            <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="stat-label">Completed Job/Task</div>
                <div class="stat-value" id="statCompleted">—</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile d-flex align-items-center gap-3">
            <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-clock-history"></i></div>
            <div>
                <div class="stat-label">On-time Rate</div>
                <div class="stat-value" id="statOnTime">—</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile d-flex align-items-center gap-3">
            <div class="stat-icon bg-warning-subtle text-warning" id="statTile3Icon"><i class="bi bi-arrow-repeat"></i></div>
            <div>
                <div class="stat-label" id="statTile3Label">Rescheduled</div>
                <div class="stat-value" id="statTile3Value">—</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-tile d-flex align-items-center gap-3">
            <div class="stat-icon bg-danger-subtle text-danger" id="statTile4Icon"><i class="bi bi-x-circle"></i></div>
            <div>
                <div class="stat-label" id="statTile4Label">Cancelled</div>
                <div class="stat-value" id="statTile4Value">—</div>
            </div>
        </div>
    </div>
</div>

<form method="post" id="evalForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card p-4 mb-4">
                <h5 class="mb-3">Evaluation Details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
                        <select asp-for="Evaluation.EmployeeID" id="employeeSelect" class="form-select">
                            <option value="">Select an employee</option>
                            @foreach (var emp in Model.EmployeeList)
                            {
                                var s = Model.Stats.GetValueOrDefault(emp.EmployeeId) ?? new TM_PE.Model.EmployeePerformanceStats();
                                <option value="@emp.EmployeeId"
                                        data-roletype="@emp.RoleType"
                                        data-completed="@s.CompletedJobsTasks"
                                        data-ontime="@s.OnTimeRate.ToString("0")"
                                        data-jobcompletion="@s.JobCompletionRate.ToString("0")"
                                        data-rescheduled="@s.Rescheduled"
                                        data-cancelled="@s.Cancelled"
                                        data-rejected="@s.RejectedActivities"
                                        data-overdue="@s.OverdueTasks">
                                    @emp.FullName (@emp.RoleType)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Evaluation.EmployeeID" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Period Month <span class="text-danger">*</span></label>
                        <select asp-for="Evaluation.EvaluationPeriodMonth" id="periodMonthSelect" class="form-select">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                        </select>
                        <span asp-validation-for="Evaluation.EvaluationPeriodMonth" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Period Year <span class="text-danger">*</span></label>
                        <select asp-for="Evaluation.EvaluationPeriodYear" id="periodYearSelect" class="form-select">
                            @foreach (var y in Model.PeriodYearOptions)
                            {
                                <option value="@y">@y</option>
                            }
                        </select>
                        <span asp-validation-for="Evaluation.EvaluationPeriodYear" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Evaluation Date <span class="text-danger">*</span></label>
                        <input asp-for="Evaluation.EvaluationDate" type="date" class="form-control"
                               value="@Model.Evaluation.EvaluationDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Evaluation.EvaluationDate" class="text-danger"></span>
                        <div class="form-text">Also used as the appraisal date.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Evaluator</label>
                        <input class="form-control" value="@Model.CurrentManagerName" disabled />
                        <div class="form-text">Automatically set to your manager account.</div>
                    </div>
                </div>
            </div>

            <div class="card p-4 mb-4" id="noEmployeeNotice">
                <div class="text-muted text-center py-3">Select an employee above to load their evaluation criteria.</div>
            </div>

            @* ===================== Field Technician criteria ===================== *@
            <div class="card p-4 mb-4 d-none" id="fieldTechnicianCriteriaCard">
                <h5 class="mb-1">Field Technician Criteria</h5>
                <div class="text-muted small mb-3">Rate each criterion from 0.5 to 5 stars — click the left half of a star for a half rating. Click the same rating again to clear it.</div>
                <partial name="_CriteriaStarRows" model="Model.RowsFor(Model.FieldTechnicianCriteria)" />
            </div>

            @* ===================== Office Staff criteria ===================== *@
            <div class="card p-4 mb-4 d-none" id="officeStaffCriteriaCard">
                <h5 class="mb-1">Office Staff Criteria</h5>
                <div class="text-muted small mb-3">Rate each criterion from 0.5 to 5 stars — click the left half of a star for a half rating. Click the same rating again to clear it.</div>
                <partial name="_CriteriaStarRows" model="Model.RowsFor(Model.OfficeStaffCriteria)" />
            </div>

            <div class="card p-4">
                <label class="form-label fw-semibold">Feedback</label>
                <textarea asp-for="Evaluation.GeneralFeedback" class="form-control" rows="3" maxlength="1000"
                          placeholder="Overall feedback for this evaluation period..."></textarea>
                <div class="form-text">Covers both the evaluation and the appraisal decision.</div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card p-4 mb-3 sticky-top" style="top:1rem">
                <h6 class="text-muted">Overall Score (preview)</h6>
                <div class="display-6 fw-bold" id="overallScorePreview">0.0</div>
                <div class="text-muted small">out of 100</div>
                <div class="mt-2 d-flex align-items-center gap-2">
                    <span id="overallStarsPreview"></span>
                    <span class="badge bg-primary-subtle text-primary" id="overallRatingPreview">—</span>
                </div>

                <hr />

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-outline-secondary" asp-page-handler="SaveDraft">
                        <i class="bi bi-save"></i> Save as Draft
                    </button>
                    <button type="submit" class="btn btn-primary" asp-page-handler="Finalize"
                            onclick="return confirm('Finalize this evaluation? Once finalized it can no longer be edited.');">
                        <i class="bi bi-check2-circle"></i> Finalize Evaluation
                    </button>
                </div>
                <div class="form-text mt-2">A draft can still be edited later; finalizing locks it.</div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/star-rating.js"></script>
    <script>
        (function () {
            // Changing the period reloads the page via GET so the server can
            // recompute period-scoped stats/automated criteria for the new
            // Month/Year - there's no client-side copy of every employee's
            // per-period ticket/task history to redo that math in JS.
            const periodMonthSelect = document.getElementById('periodMonthSelect');
            const periodYearSelect = document.getElementById('periodYearSelect');
            const employeeSelect = document.getElementById('employeeSelect');
            function reloadForPeriod() {
                const params = new URLSearchParams();
                params.set('Month', periodMonthSelect.value);
                params.set('Year', periodYearSelect.value);
                // Carry the currently selected employee through the reload so
                // changing the period doesn't reset "Select an employee".
                if (employeeSelect.value) params.set('EmployeeId', employeeSelect.value);
                window.location.href = window.location.pathname + '?' + params.toString();
            }
            periodMonthSelect.addEventListener('change', reloadForPeriod);
            periodYearSelect.addEventListener('change', reloadForPeriod);
            const noEmployeeNotice = document.getElementById('noEmployeeNotice');
            const ftCard = document.getElementById('fieldTechnicianCriteriaCard');
            const osCard = document.getElementById('officeStaffCriteriaCard');
            const scorePreview = document.getElementById('overallScorePreview');
            const ratingPreview = document.getElementById('overallRatingPreview');
            const starsPreview = document.getElementById('overallStarsPreview');

            // Rating bands mirrored from Model.EvaluationScoring for the live
            // client-side preview only - the server always recalculates and is
            // the source of truth for what actually gets saved.
            const bands = [[90, 'Excellent'], [80, 'Very Good'], [70, 'Good'], [60, 'Needs Improvement'], [0, 'Poor']];

            function ratingFor(score) {
                for (const [min, label] of bands) { if (score >= min) return label; }
                return 'Poor';
            }

            function setBlockEnabled(card, enabled) {
                card.classList.toggle('d-none', !enabled);
                card.querySelectorAll('input, select, textarea').forEach(el => {
                    el.disabled = !enabled;
                    if (!enabled && el.classList.contains('star-value-input')) el.value = 0;
                });
                if (!enabled) {
                    card.querySelectorAll('[data-star-input]').forEach(c => window.StarRating.paint(c, 0));
                }
            }

            function recalcPreview() {
                let total = 0;
                document.querySelectorAll('.star-value-input:not(:disabled)').forEach(input => {
                    const weight = parseFloat(input.dataset.weight || '0');
                    const stars = window.StarRating.snap(input.value || '0');
                    total += weight * stars / 5;
                });
                scorePreview.textContent = total.toFixed(1);
                ratingPreview.textContent = ratingFor(total);
                starsPreview.innerHTML = window.StarRating.render(total / 20);
            }

            const tile3Icon = document.getElementById('statTile3Icon');
            const tile3Label = document.getElementById('statTile3Label');
            const tile3Value = document.getElementById('statTile3Value');
            const tile4Icon = document.getElementById('statTile4Icon');
            const tile4Label = document.getElementById('statTile4Label');
            const tile4Value = document.getElementById('statTile4Value');

            // Tiles 3/4 show different metrics depending on the selected
            // employee's role: job ticket Rescheduled/Cancelled counts for a
            // Field Technician, since Office Staff office tasks never use those
            // statuses; Rejected activities/Overdue tasks for an Office Staff,
            // since those are the equivalents that actually apply there.
            function applyStats(opt) {
                const has = opt && opt.value;
                const isOfficeStaff = has && opt.getAttribute('data-roletype') === 'OfficeStaff';

                document.getElementById('statCompleted').textContent = has ? opt.dataset.completed : '—';
                document.getElementById('statOnTime').textContent = has ? opt.dataset.ontime + '%' : '—';

                if (isOfficeStaff) {
                    tile3Icon.className = 'stat-icon bg-danger-subtle text-danger';
                    tile3Icon.innerHTML = '<i class="bi bi-hand-thumbs-down"></i>';
                    tile3Label.textContent = 'Rejected Activities';
                    tile3Value.textContent = opt.dataset.rejected;

                    tile4Icon.className = 'stat-icon bg-warning-subtle text-warning';
                    tile4Icon.innerHTML = '<i class="bi bi-exclamation-triangle"></i>';
                    tile4Label.textContent = 'Overdue Task';
                    tile4Value.textContent = opt.dataset.overdue;
                } else {
                    tile3Icon.className = 'stat-icon bg-warning-subtle text-warning';
                    tile3Icon.innerHTML = '<i class="bi bi-arrow-repeat"></i>';
                    tile3Label.textContent = 'Rescheduled';
                    tile3Value.textContent = has ? opt.dataset.rescheduled : '—';

                    tile4Icon.className = 'stat-icon bg-danger-subtle text-danger';
                    tile4Icon.innerHTML = '<i class="bi bi-x-circle"></i>';
                    tile4Label.textContent = 'Cancelled';
                    tile4Value.textContent = has ? opt.dataset.cancelled : '—';
                }
            }

            // Job Completion / Timeliness criteria (see Model.Criteria.MetricType)
            // are auto-scored from the selected technician's actual job ticket
            // record instead of starting at 0. Their star-rating widgets are
            // rendered readonly server-side (_CriteriaStarRows.cshtml), so this
            // is the only way their value ever changes - the manager can't
            // adjust them by hand. A rate out of 100 maps to stars out of 5 the
            // same way EvaluationScoring.StarsFor does server-side (rate / 20),
            // then snaps to the nearest half star.
            function autoFillMetricCriteria(card, opt) {
                card.querySelectorAll('[data-star-input]').forEach(function (container) {
                    const metricType = container.dataset.metricType;
                    if (metricType !== 'JobCompletion' && metricType !== 'Timeliness') return;

                    const rate = parseFloat((metricType === 'JobCompletion'
                        ? opt.dataset.jobcompletion
                        : opt.dataset.ontime) || '0');

                    const target = document.getElementById(container.dataset.target);
                    if (!target) return;

                    const stars = window.StarRating.snap(rate / 20);
                    target.value = stars;
                    window.StarRating.paint(container, stars);
                });
            }

            employeeSelect.addEventListener('change', function () {
                const opt = employeeSelect.options[employeeSelect.selectedIndex];
                const roleType = opt ? opt.getAttribute('data-roletype') : '';

                applyStats(opt);

                if (!roleType) {
                    noEmployeeNotice.classList.remove('d-none');
                    setBlockEnabled(ftCard, false);
                    setBlockEnabled(osCard, false);
                    recalcPreview();
                    return;
                }

                noEmployeeNotice.classList.add('d-none');
                const isFieldTechnician = roleType === 'FieldTechnician';
                setBlockEnabled(ftCard, isFieldTechnician);
                setBlockEnabled(osCard, roleType === 'OfficeStaff');
                if (isFieldTechnician) autoFillMetricCriteria(ftCard, opt);
                recalcPreview();
            });

            document.addEventListener('change', function (e) {
                if (e.target.classList.contains('star-value-input')) recalcPreview();
            });

            // Initial state (also covers a validation-failure postback, where
            // the server re-renders the manager's previously entered ratings
            // and selected employee). Only reset both cards up front when no
            // employee is selected - if one is, dispatching 'change' below
            // enables/preserves whichever card matches that employee's role
            // and disables (zeroing) only the other one, so a postback never
            // wipes out ratings the manager already entered.
            window.StarRating.initAll(document);
            if (employeeSelect.value) {
                employeeSelect.dispatchEvent(new Event('change'));
            } else {
                setBlockEnabled(ftCard, false);
                setBlockEnabled(osCard, false);
                applyStats(null);
                recalcPreview();
            }
        })();
    </script>
}
