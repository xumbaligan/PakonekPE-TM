@page
@model TM_PE.Pages.Manager.PerformanceEvaluation.IndexModel
@{
    ViewData["Title"] = "Performance Evaluation";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard-data"></i> Performance Evaluation</h2>
    <a class="btn btn-primary" asp-page="Create"><i class="bi bi-plus-lg"></i> New Evaluation</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" name="Search" value="@Model.Search"
               placeholder="Search by employee or evaluator..." />
    </div>
    <div class="col-md-3">
        <select class="form-select" name="StatusFilter" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="Draft" selected="@(Model.StatusFilter == "Draft")">Draft</option>
            <option value="Finalized" selected="@(Model.StatusFilter == "Finalized")">Finalized</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" type="submit"><i class="bi bi-search"></i> Filter</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Employee</th>
                    <th>Period</th>
                    <th>Evaluator</th>
                    <th>Evaluation Date</th>
                    <th>Rating</th>
                    <th>Score</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Evaluations.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">No performance evaluations yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var e in Model.Evaluations)
                    {
                        var results = IndexModel.BuildResultViews(e);
                        var evalStats = Model.EvaluationStats.GetValueOrDefault(e.EvaluationID) ?? new TM_PE.Model.EmployeePerformanceStats();

                        <tr>
                            <td>
                                <strong>@(e.Employee?.FullName ?? "-")</strong>
                                <div class="text-muted small">@e.Employee?.RoleType</div>
                            </td>
                            <td>@e.EvaluationPeriod</td>
                            <td>@e.EvaluatorName</td>
                            <td>@e.EvaluationDate.ToString("MMM d, yyyy")</td>
                            <td>
                                <partial name="_Stars" model="e.OverallStars" />
                                <div class="text-muted small">@e.OverallRating</div>
                            </td>
                            <td>@e.OverallScore.ToString("0.##") / 4</td>
                            <td>
                                @if (e.EvaluationStatus == TM_PE.Model.EvaluationStatus.Finalized)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Finalized</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Draft</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary view-evaluation-btn"
                                        data-bs-toggle="modal" data-bs-target="#evaluationModal"
                                        data-employee="@(e.Employee?.FullName ?? "-")"
                                        data-role="@(e.Employee?.RoleType.ToString() ?? "-")"
                                        data-role-type="@(e.Employee?.RoleType.ToString() ?? "")"
                                        data-period="@e.EvaluationPeriod"
                                        data-evaluator="@e.EvaluatorName"
                                        data-date="@e.EvaluationDate.ToString("MMMM d, yyyy")"
                                        data-overall-score="@e.OverallScore.ToString("0.##")"
                                        data-rating="@e.OverallRating"
                                        data-status="@e.EvaluationStatus"
                                        data-feedback="@e.GeneralFeedback"
                                        data-results="@System.Text.Json.JsonSerializer.Serialize(results)"
                                        data-completed="@evalStats.CompletedJobsTasks"
                                        data-ontime="@evalStats.OnTimeRate.ToString("0")"
                                        data-rescheduled="@evalStats.Rescheduled"
                                        data-cancelled="@evalStats.Cancelled"
                                        data-rejected="@evalStats.RejectedActivities"
                                        data-overdue="@evalStats.OverdueTasks"
                                        title="View full evaluation">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (e.EvaluationStatus == TM_PE.Model.EvaluationStatus.Draft)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@e.EvaluationID" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_EvaluationModal" />

@section Scripts {
    <script src="~/js/star-rating.js" asp-append-version="true"></script>
    <script src="~/js/evaluation-modal.js" asp-append-version="true"></script>
}
