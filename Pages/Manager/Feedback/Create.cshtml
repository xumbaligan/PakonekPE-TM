@page
@model TM_PE.Pages.Manager.Feedback.CreateModel
@{
    ViewData["Title"] = "New Feedback";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-chat-square-text"></i> New Feedback</h2>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="alert alert-info small">
    <i class="bi bi-info-circle"></i>
    Feedback is qualitative and stays on record permanently — it is never overwritten by a new
    Performance Evaluation, even if you link one below.
</div>

<div class="card p-4" style="max-width:700px">
    <form method="post">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
                <select asp-for="Item.EmployeeID" id="employeeSelect" class="form-select">
                    <option value="">Select an employee</option>
                    @foreach (var emp in Model.EmployeeList)
                    {
                        <option value="@emp.EmployeeId" data-employee-id="@emp.EmployeeId">@emp.FullName (@emp.RoleType)</option>
                    }
                </select>
                <span asp-validation-for="Item.EmployeeID" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Submitted By <span class="text-danger">*</span></label>
                <input asp-for="Item.SubmittedBy" class="form-control" maxlength="100" />
                <span asp-validation-for="Item.SubmittedBy" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Feedback Type <span class="text-danger">*</span></label>
                <select asp-for="Item.FeedbackType" class="form-select">
                    @foreach (var t in Enum.GetValues<TM_PE.Model.FeedbackType>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Related Evaluation <span class="text-muted">(optional)</span></label>
                <select asp-for="Item.EvaluationID" id="evaluationSelect" class="form-select">
                    <option value="">None</option>
                    @foreach (var ev in Model.EvaluationList)
                    {
                        <option value="@ev.EvaluationID" data-employee-id="@ev.EmployeeID">
                            @ev.EvaluationPeriod — Evaluation #@ev.EvaluationID
                        </option>
                    }
                </select>
                <div class="form-text">Only evaluations for the selected employee will be selectable.</div>
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold">Comment <span class="text-danger">*</span></label>
                <textarea asp-for="Item.Comment" class="form-control" rows="4" maxlength="1000"
                          placeholder="e.g. Consistently completes assigned maintenance work within the scheduled period."></textarea>
                <span asp-validation-for="Item.Comment" class="text-danger"></span>
            </div>
        </div>

        <button class="btn btn-primary mt-3"><i class="bi bi-save"></i> Save Feedback</button>
        <a class="btn btn-secondary mt-3" asp-page="Index">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const employeeSelect = document.getElementById('employeeSelect');
            const evaluationSelect = document.getElementById('evaluationSelect');
            const allEvalOptions = Array.from(evaluationSelect.options);

            function filterEvaluations() {
                const empId = employeeSelect.value;
                evaluationSelect.innerHTML = '';
                evaluationSelect.appendChild(allEvalOptions[0].cloneNode(true)); // "None"

                allEvalOptions.slice(1).forEach(opt => {
                    if (!empId || opt.dataset.employeeId === empId) {
                        evaluationSelect.appendChild(opt.cloneNode(true));
                    }
                });
            }

            employeeSelect.addEventListener('change', filterEvaluations);
            filterEvaluations();
        })();
    </script>
}
