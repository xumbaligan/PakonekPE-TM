@page "{id:int}"
@model TM_PE.Pages.Manager.Feedback.DetailsModel
@{
    ViewData["Title"] = "Feedback Details";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-chat-square-text"></i> Feedback Details</h2>
    <div>
        <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@Model.Item.FeedbackID"><i class="bi bi-trash"></i> Delete</a>
        <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
</div>

<div class="card p-4" style="max-width:700px">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="text-muted small">Employee</div>
            <div class="fw-semibold">@(Model.Item.Employee?.FullName ?? "—")</div>
            <div class="text-muted small">@Model.Item.Employee?.RoleType</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">Submitted By</div>
            <div class="fw-semibold">@Model.Item.SubmittedBy</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">Feedback Type</div>
            <div class="fw-semibold">@Model.Item.FeedbackType</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">Related Evaluation</div>
            <div class="fw-semibold">@(Model.Item.Evaluation != null ? Model.Item.Evaluation.EvaluationPeriod : "—")</div>
        </div>
        <div class="col-md-6">
            <div class="text-muted small">Date Created</div>
            <div class="fw-semibold">@Model.Item.DateCreated.ToString("MMMM d, yyyy")</div>
        </div>
        <div class="col-12">
            <div class="text-muted small">Comment</div>
            <div>@Model.Item.Comment</div>
        </div>
    </div>
</div>
