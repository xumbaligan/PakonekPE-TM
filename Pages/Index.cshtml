<h5 class="mb-3">Employee Performance</h5>
<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="stat-tile">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-speedometer2"></i></div>
                <div class="stat-label">Average Performance Score</div>
            </div>
            <div class="stat-value">@Model.AveragePerformanceScore.ToString("0.#")</div>
            <div class="text-muted small mb-2">out of 4, across latest evaluations</div>
            <div class="d-flex justify-content-between small">
                <span>Office Staff avg: <strong>@Model.AverageOfficeStaffScore.ToString("0.#")</strong></span>
                <span>Field Technician avg: <strong>@Model.AverageFieldTechnicianScore.ToString("0.#")</strong></span>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="stat-tile">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-trophy"></i></div>
                <div class="stat-label">Highest Performing Employees</div>
            </div>
            @if (!Model.TopPerformers.Any())
            {
                <div class="text-muted small">No evaluations recorded yet.</div>
            }
            else
            {
                @foreach (var p in Model.TopPerformers)
                {
                    <div class="d-flex justify-content-between border-bottom py-1">
                        <span>@p.Name</span>
                        <span class="fw-semibold">@p.Score.ToString("0.#") — @p.Rating</span>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="stat-tile">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="stat-label">Employees Requiring Improvement</div>
            </div>
            @if (!Model.NeedsImprovement.Any())
            {
                <div class="text-muted small">None right now.</div>
            }
            else
            {
                @foreach (var p in Model.NeedsImprovement)
                {
                    <div class="d-flex justify-content-between border-bottom py-1">
                        <span>@p.Name</span>
                        <span class="fw-semibold text-danger">@p.Score.ToString("0.#") — @p.Rating</span>
                    </div>
                }
            }
        </div>
    </div>
</div>
