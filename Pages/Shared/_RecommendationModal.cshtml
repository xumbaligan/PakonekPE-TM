@model List<TM_PE.Model.Recommendation>
@*
    Manager-maintained list of appraisal recommendations. Same shape as the
    "Fiber Plans" modal on Job Ticket Create: type a recommendation, press Add,
    and remove any entry with its x button. Adds/deletes go straight to
    tbl_recommendation over AJAX (see wwwroot/js/recommendation-modal.js) so the
    evaluation form the manager is filling in is never disturbed.
*@
<div class="modal fade" id="recommendationModal" tabindex="-1" aria-labelledby="recommendationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="recommendationModalLabel">Recommendations</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-2">
                    <input type="text" id="newRecommendationInput" class="form-control"
                           placeholder="e.g. Promotion Recommended" maxlength="100" />
                    <button type="button" id="addRecommendationBtn" class="btn btn-primary text-nowrap">Add</button>
                </div>
                <div class="form-text mb-2">Letters, numbers, spaces, and . , - / # &amp; ( ) are allowed.</div>
                <div id="recommendationModalError" class="text-danger small mb-2 d-none"></div>

                <ul class="list-group" id="recommendationList">
                    @foreach (var rec in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center"
                            data-rec-id="@rec.RecommendationID" data-rec-name="@rec.RecommendationName">
                            <span>@rec.RecommendationName</span>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 recommendation-delete-btn" title="Delete">&times;</button>
                        </li>
                    }
                </ul>
                <div id="noRecommendationsMsg" class="text-muted small mt-2 @(Model.Any() ? "d-none" : "")">
                    No recommendations yet.
                </div>
            </div>
        </div>
    </div>
</div>
