@page
@model TM_PE.Pages.Manager.AppraisalRecords.IndexModel
@{
    ViewData["Title"] = "Feedback & Appraisal Records";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h2><i class="bi bi-award"></i> Feedback &amp; Appraisal Records</h2>
</div>
<p class="text-muted">Every employee's appraisal standing, rolled up from all of their performance evaluations.</p>

<div class="row g-2 mb-3">
    <div class="col-md-7">
        <input class="form-control" id="recordSearch" placeholder="Search by employee name or ID..." />
    </div>
    <div class="col-md-5">
        <select class="form-select" id="roleFilter">
            <option value="">All Roles</option>
            <option value="FieldTechnician">Field Technician</option>
            <option value="OfficeStaff">Office Staff</option>
        </select>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:120px">Employee ID</th>
                    <th>Employee Name</th>
                    <th style="width:160px">Role</th>
                    <th style="width:240px">Overall Rating</th>
                    <th class="text-end" style="width:100px">Action</th>
                </tr>
            </thead>
            <tbody id="recordsBody">
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No employees to show yet.</td></tr>
                }
                else
                {
                    @foreach (var r in Model.Rows)
                    {
                        var ratingClass = TM_PE.Model.EvaluationScoring.RatingBadgeClass(r.OverallRating);
                        <tr data-name="@r.FullName.ToLower()" data-empid="@r.EmployeeId" data-role="@r.RoleType">
                            <td><span class="badge bg-light text-dark border">#@r.EmployeeId</span></td>
                            <td>
                                <strong>@r.FullName</strong>
                                <div class="text-muted small">@r.DepartmentName</div>
                            </td>
                            <td>
                                @if (r.RoleType == TM_PE.Model.RoleType.FieldTechnician)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis">Field Technician</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis">Office Staff</span>
                                }
                            </td>
                            <td>
                                @if (r.EvaluationCount == 0)
                                {
                                    <span class="text-muted small">Not yet evaluated</span>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <partial name="_Stars" model="r.OverallStars" />
                                        <span class="fw-semibold">@r.OverallScore.ToString("0.##")</span>
                                        <span class="text-muted small">/ 100</span>
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge bg-@(ratingClass)-subtle text-@(ratingClass)-emphasis">@r.OverallRating</span>
                                        <span class="text-muted small ms-1">@r.EvaluationCount evaluation@(r.EvaluationCount == 1 ? "" : "s")</span>
                                    </div>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@r.EmployeeId"
                                   title="View appraisal record">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    <tr id="noMatchRow" class="d-none">
                        <td colspan="5" class="text-center text-muted py-4">No employees match your filters.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const search = document.getElementById('recordSearch');
            const roleFilter = document.getElementById('roleFilter');
            const noMatch = document.getElementById('noMatchRow');

            function applyFilters() {
                const term = search.value.trim().toLowerCase();
                const role = roleFilter.value;
                let visible = 0;

                document.querySelectorAll('#recordsBody tr[data-name]').forEach(row => {
                    const matchesTerm = !term
                        || row.dataset.name.includes(term)
                        || row.dataset.empid.includes(term);
                    const matchesRole = !role || row.dataset.role === role;
                    const show = matchesTerm && matchesRole;
                    row.classList.toggle('d-none', !show);
                    if (show) visible++;
                });

                if (noMatch) noMatch.classList.toggle('d-none', visible > 0);
            }

            search.addEventListener('input', applyFilters);
            roleFilter.addEventListener('change', applyFilters);
        })();
    </script>
}
