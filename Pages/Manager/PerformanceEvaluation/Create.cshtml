@page
@model TM_PE.Pages.Manager.PerformanceEvaluation.CreateModel
@{
    ViewData["Title"] = "New Performance Evaluation";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard-data"></i> New Performance Evaluation</h2>
    <a class="btn btn-outline-secondary" asp-page="Index"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="alert alert-info small">
    <i class="bi bi-info-circle"></i>
    This evaluation is its own historical record. Completed jobs/tasks below are shown only as
    supporting information — saving this form never changes any Job Ticket or Office Task.
</div>

<form method="post" id="evalForm">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card p-4 mb-4">
                <h5 class="mb-3">Evaluation Details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
                        <select asp-for="Evaluation.EmployeeID" id="employeeSelect" class="form-select">
                            <option value="">Select an employee</option>
                            @foreach (var emp in Model.EmployeeList)
                            {
                                var info = Model.SupportInfo.GetValueOrDefault(emp.EmployeeId) ?? new CreateModel.EmployeeSupportInfo();
                                <option value="@emp.EmployeeId"
                                        data-roletype="@emp.RoleType"
                                        data-completed-tickets="@info.CompletedJobTickets"
                                        data-active-tickets="@info.ActiveJobTickets"
                                        data-completed-tasks="@info.CompletedOfficeTasks"
                                        data-active-tasks="@info.ActiveOfficeTasks"
                                        data-avg-score="@info.AverageTaskScore">
                                    @emp.FullName (@emp.RoleType)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Evaluation.EmployeeID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Evaluator <span class="text-danger">*</span></label>
                        <input asp-for="Evaluation.EvaluatorName" class="form-control" maxlength="100" />
                        <span asp-validation-for="Evaluation.EvaluatorName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Evaluation Period <span class="text-danger">*</span></label>
                        <input asp-for="Evaluation.EvaluationPeriod" class="form-control" placeholder="e.g. August 2026" maxlength="50" />
                        <span asp-validation-for="Evaluation.EvaluationPeriod" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Evaluation Date <span class="text-danger">*</span></label>
                        <input asp-for="Evaluation.EvaluationDate" type="date" class="form-control"
                               value="@Model.Evaluation.EvaluationDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Evaluation.EvaluationDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Evaluation Status</label>
                        <select asp-for="Evaluation.EvaluationStatus" class="form-select">
                            <option value="Draft">Draft</option>
                            <option value="Finalized">Finalized</option>
                        </select>
                        <div class="form-text">Draft can still be edited later; Finalized locks the evaluation.</div>
                    </div>
                </div>
            </div>

            <div class="card p-4 mb-4" id="noEmployeeNotice">
                <div class="text-muted text-center py-3">Select an employee above to load their evaluation criteria.</div>
            </div>

            @* ===================== Field Technician criteria ===================== *@
            <div class="card p-4 mb-4 d-none" id="fieldTechnicianCriteriaCard">
                <h5 class="mb-3">Field Technician Criteria</h5>
                <table class="table align-middle">
                    <thead>
                        <tr class="text-muted small">
                            <th>Criteria</th>
                            <th style="width:140px">Score</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.FieldTechnicianCriteria.Count; i++)
                        {
                            var c = Model.FieldTechnicianCriteria[i];
                            <tr>
                                <td>
                                    <div class="fw-semibold">@c.CriteriaName</div>
                                    <div class="text-muted small">@c.Description (@c.Weight%)</div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control criteria-score-input"
                                               name="Results[@i].Score" min="0" max="@c.Weight" step="0.5"
                                               value="0" disabled data-criteria-id="@c.CriteriaId" data-max="@c.Weight" />
                                        <span class="input-group-text">/ @c.Weight</span>
                                    </div>
                                    <input type="hidden" name="Results[@i].CriteriaID" value="@c.CriteriaId" disabled class="criteria-id-input" />
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" name="Results[@i].Remarks" maxlength="500" disabled />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ===================== Office Staff criteria ===================== *@
            <div class="card p-4 mb-4 d-none" id="officeStaffCriteriaCard">
                <h5 class="mb-3">Office Staff Criteria</h5>
                <table class="table align-middle">
                    <thead>
                        <tr class="text-muted small">
                            <th>Criteria</th>
                            <th style="width:140px">Score</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.OfficeStaffCriteria.Count; i++)
                        {
                            var c = Model.OfficeStaffCriteria[i];
                            var idx = Model.FieldTechnicianCriteria.Count + i;
                            <tr>
                                <td>
                                    <div class="fw-semibold">@c.CriteriaName</div>
                                    <div class="text-muted small">@c.Description (@c.Weight%)</div>
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control criteria-score-input"
                                               name="Results[@idx].Score" min="0" max="@c.Weight" step="0.5"
                                               value="0" disabled data-criteria-id="@c.CriteriaId" data-max="@c.Weight" />
                                        <span class="input-group-text">/ @c.Weight</span>
                                    </div>
                                    <input type="hidden" name="Results[@idx].CriteriaID" value="@c.CriteriaId" disabled class="criteria-id-input" />
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" name="Results[@idx].Remarks" maxlength="500" disabled />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="card p-4">
                <label class="form-label fw-semibold">General Remarks</label>
                <textarea asp-for="Evaluation.GeneralRemarks" class="form-control" rows="3" maxlength="1000"></textarea>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card p-4 mb-4 sticky-top" style="top:1rem">
                <h5 class="mb-3">Supporting Information</h5>
                <div id="supportInfoBox" class="text-muted small">Select an employee to see their workload stats.</div>

                <hr />

                <h6 class="text-muted">Overall Score (preview)</h6>
                <div class="display-6 fw-bold" id="overallScorePreview">0.0</div>
                <div class="text-muted small">out of 100</div>
                <div class="mt-2">
                    <span class="badge bg-primary-subtle text-primary" id="overallRatingPreview">—</span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-save"></i> Save Evaluation</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const employeeSelect = document.getElementById('employeeSelect');
            const noEmployeeNotice = document.getElementById('noEmployeeNotice');
            const ftCard = document.getElementById('fieldTechnicianCriteriaCard');
            const osCard = document.getElementById('officeStaffCriteriaCard');
            const supportInfoBox = document.getElementById('supportInfoBox');
            const scorePreview = document.getElementById('overallScorePreview');
            const ratingPreview = document.getElementById('overallRatingPreview');

            // Rating bands mirrored from Model.EvaluationScoring for the live
            // client-side preview only — the server always recalculates and is
            // the source of truth for what actually gets saved.
            const bands = [
                [90, 'Excellent'],
                [80, 'Very Good'],
                [70, 'Good'],
                [60, 'Needs Improvement'],
                [0, 'Poor']
            ];

            function ratingFor(score) {
                for (const [min, label] of bands) {
                    if (score >= min) return label;
                }
                return 'Poor';
            }

            function setBlockEnabled(card, enabled) {
                card.classList.toggle('d-none', !enabled);
                card.querySelectorAll('input').forEach(input => {
                    input.disabled = !enabled;
                    if (!enabled && input.classList.contains('criteria-score-input')) {
                        input.value = 0;
                    }
                });
            }

            function recalcPreview() {
                let total = 0;
                document.querySelectorAll('.criteria-score-input:not(:disabled)').forEach(input => {
                    const max = parseFloat(input.dataset.max || '0');
                    let val = parseFloat(input.value || '0');
                    if (isNaN(val)) val = 0;
                    val = Math.min(Math.max(val, 0), max);
                    total += val;
                });
                scorePreview.textContent = total.toFixed(1);
                ratingPreview.textContent = ratingFor(total);
            }

            employeeSelect.addEventListener('change', function () {
                const opt = employeeSelect.options[employeeSelect.selectedIndex];
                const roleType = opt ? opt.getAttribute('data-roletype') : '';

                if (!roleType) {
                    noEmployeeNotice.classList.remove('d-none');
                    setBlockEnabled(ftCard, false);
                    setBlockEnabled(osCard, false);
                    supportInfoBox.innerHTML = 'Select an employee to see their workload stats.';
                    recalcPreview();
                    return;
                }

                noEmployeeNotice.classList.add('d-none');
                setBlockEnabled(ftCard, roleType === 'FieldTechnician');
                setBlockEnabled(osCard, roleType === 'OfficeStaff');

                if (roleType === 'FieldTechnician') {
                    supportInfoBox.innerHTML = `
                        <div class="d-flex justify-content-between"><span>Completed job tickets</span><strong>${opt.dataset.completedTickets}</strong></div>
                        <div class="d-flex justify-content-between"><span>Active job tickets</span><strong>${opt.dataset.activeTickets}</strong></div>
                        <div class="text-muted mt-2" style="font-size:.8rem">All-time totals, not limited to the evaluation period.</div>
                    `;
                } else {
                    supportInfoBox.innerHTML = `
                        <div class="d-flex justify-content-between"><span>Completed office tasks</span><strong>${opt.dataset.completedTasks}</strong></div>
                        <div class="d-flex justify-content-between"><span>Active office tasks</span><strong>${opt.dataset.activeTasks}</strong></div>
                        <div class="d-flex justify-content-between"><span>Average task score</span><strong>${opt.dataset.avgScore}</strong></div>
                        <div class="text-muted mt-2" style="font-size:.8rem">All-time totals, not limited to the evaluation period.</div>
                    `;
                }

                recalcPreview();
            });

            document.addEventListener('input', function (e) {
                if (e.target.classList.contains('criteria-score-input')) recalcPreview();
            });

            // Restore selection on validation-failure postback.
            if (employeeSelect.value) {
                employeeSelect.dispatchEvent(new Event('change'));
            }
        })();
    </script>
}
